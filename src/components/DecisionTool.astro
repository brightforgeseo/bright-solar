---
const {slug}=Astro.props;
const hybrid=slug==='hybrid-solar';
const options:Record<string,{label:string;choices:[string,string][]}>={
 'felicity-solar':{label:'What are you selecting?',choices:[['A new system','Bring the property use, supply details and essential loads. Ask for one documented, compatible configuration.'],['A battery for existing solar','Bring the exact existing inverter model. Confirm supported battery models and operating limits before buying.'],['An off-grid configuration','Bring the full daily load inventory and any generator details. Assess charging, storage and backup together.']]},
 'home-solar':{label:'When is your home busiest?',choices:[['During daylight','Daytime loads are the starting point. Bring a recent bill and list the appliances that usually run together.'],['Mostly evenings','Explore daytime demand first, then decide whether storing solar for later use is a separate priority.'],['It varies','Bring more than one bill and describe weekday, weekend and seasonal changes.']]},
 'commercial-solar':{label:'Which operating pattern fits?',choices:[['Daytime trading','Record opening hours and major loads, including anything that continues overnight.'],['Evening or overnight','A monthly bill alone will not show overlap with solar generation. Bring time-of-use or interval data if available.'],['Seasonal or variable','Explain the busy and quiet periods. Avoid sizing the assessment around only the highest-use month.']]},
 'off-grid-solar':{label:'What electricity supply exists?',choices:[['No grid connection','Start with a complete daily load inventory and the essential loads that cannot wait.'],['Grid, but unreliable','Compare a hybrid backup assessment before assuming a completely off-grid system is needed.'],['An existing generator','Bring generator and changeover details. Integration must be confirmed by the technical designer.']]},
 'net-metering':{label:'Where is your project now?',choices:[['Considering solar','Check your utility’s current application requirements before committing to equipment.'],['Have a technical proposal','Confirm which party owns the documents, utility assessment, inspection and any excluded work.'],['Installed, not yet approved','Contact your utility and qualified implementation team. Installation alone is not permission to energise or export.']]}
};
const option=options[slug];
---
<div class="check-tool" data-tool={slug}>
{hybrid ? <><h3>Put the essential load into numbers.</h3><label for="load-watts">Combined running load (watts)</label><input id="load-watts" type="number" min="1" max="100000" step="1" value="500"/><label for="load-hours">Desired running time (hours)</label><input id="load-hours" type="number" min="0.1" max="168" step="0.1" value="4"/><output id="planner-result" aria-live="polite">2.00 kWh of raw load energy.</output><p class="tool-note">Watts × hours ÷ 1,000. This is energy consumed by a constant load, not a battery size or runtime promise. It excludes starting surges, losses, reserves and usable-capacity limits.</p></> : slug==='solar-panel-cost' ? <><h3>Is the quotation specific enough?</h3><p>Tick what is explicitly documented, not what you assume is included.</p>{['Exact panel and inverter models','Battery model and configuration, if included','Mounting, protection and electrical works','Connection tasks, fees and exclusions','Warranty terms and after-sales responsibility'].map((text,i)=><label><input type="checkbox" class="scope-check" value={String(i)}/>{text}</label>)}<output id="planner-result" aria-live="polite">0 of 5 scope areas documented. Ask about the missing items.</output><p class="tool-note">A complete checklist is not technical approval or proof of value. Compare the actual documents and survey findings.</p></> : option && <><label for="route-scenario">{option.label}</label><select id="route-scenario">{option.choices.map(([label,answer])=><option value={answer}>{label}</option>)}</select><output id="planner-result" aria-live="polite">{option.choices[0][1]}</output></>}
</div>
<script>
const watts=document.querySelector<HTMLInputElement>('#load-watts');
const hours=document.querySelector<HTMLInputElement>('#load-hours');
const result=document.querySelector<HTMLOutputElement>('#planner-result');
const calculate=()=>{if(!watts||!hours||!result)return;const w=Number(watts.value),h=Number(hours.value);result.textContent=(!watts.value||!hours.value||!Number.isFinite(w)||!Number.isFinite(h)||w<=0||h<=0||w>100000||h>168)?'Enter a positive load up to 100,000 W and duration up to 168 hours.':`${(w*h/1000).toFixed(2)} kWh of raw load energy. This is not a battery size.`;};
watts?.addEventListener('input',calculate);hours?.addEventListener('input',calculate);
const scenario=document.querySelector<HTMLSelectElement>('#route-scenario');scenario?.addEventListener('change',()=>{if(result)result.textContent=scenario.value;});
const checks=document.querySelectorAll<HTMLInputElement>('.scope-check');checks.forEach(check=>check.addEventListener('change',()=>{const n=Array.from(checks).filter(c=>c.checked).length;if(result)result.textContent=`${n} of 5 scope areas documented. ${n===5?'Now compare the details, not just the total.':'Ask about the missing items.'}`;}));
</script>

---
const groups=[{title:'Find your system',links:[['Home solar','/home-solar/','Start with the household and its daily routine.'],['Commercial solar','/commercial-solar/','Match the system to your operating day.'],['Hybrid solar & batteries','/hybrid-solar/','Plan storage and essential backup loads.'],['Off-grid solar','/off-grid-solar/','Consider the complete independent supply.']]},{title:'Equipment & planning',links:[['Felicity Solar range','/felicity-solar/','Explore inverter and battery selection.'],['Solar costs','/solar-panel-cost/','Compare system sizes and quotation scope.'],['Net metering','/net-metering/','Understand utility requirements.']]},{title:'Explore Bright Solar',links:[['Home','/','Discover Bright Solar.'],['News & guides','/news/','Practical reading for your solar decisions.'],['Build your brief','/assessment/','Prepare and download your property notes.'],['Privacy','/privacy/','How the website handles information.']]}];
const current=Astro.url.pathname.replace(/\/$/,'')||'/';
---
<header id="top" class="mega-header"><div class="mega-bar"><a class="mega-brand" href="/" aria-label="Bright Solar home"><img src="/bright-solar-logo.svg" width="172" height="39" alt="Bright Solar"/></a><a class="mega-quick" href="/assessment/">Build your brief ↗</a><details class="mega-disclosure" id="mega-nav"><summary id="mega-toggle" aria-controls="mega-panel">Explore <span class="mega-desktop-word">solar</span><span class="mega-icon" aria-hidden="true">+</span></summary><nav id="mega-panel" aria-label="All pages"><div class="mega-intro"><p>YOUR NEXT STEP STARTS HERE</p><strong>Find the right direction.</strong><span>Systems, equipment and useful answers.<br/>All in one place.</span></div><div class="mega-groups">{groups.map(group=><section><h2>{group.title}</h2><ul>{group.links.map(([label,href,description])=><li><a href={href} aria-current={(href.replace(/\/$/,'')||'/')===current?'page':undefined}><strong>{label}<span aria-hidden="true">↗</span></strong><span>{description}</span></a></li>)}</ul></section>)}</div><div class="mega-bottom"><a href="/#projects">Project photographs</a><a href="/#process">Our process</a><a href="/#faq">Frequently asked questions</a></div></nav></details></div></header>
<script>
const disclosure=document.querySelector<HTMLDetailsElement>('#mega-nav')!;
const toggle=document.querySelector<HTMLElement>('#mega-toggle')!;
const close=(restore=false)=>{disclosure.open=false;if(restore)toggle.focus();};
document.addEventListener('keydown',event=>{if(event.key==='Escape'&&disclosure.open){event.preventDefault();close(true);}});
document.addEventListener('click',event=>{if(disclosure.open&&event.target instanceof Node&&!disclosure.contains(event.target))close();});
disclosure.addEventListener('focusout',event=>{if(event.relatedTarget instanceof Node&&!disclosure.contains(event.relatedTarget))close();});
disclosure.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>close()));
</script>
<style>
.mega-header{position:relative;z-index:40;background:#fff;border-bottom:1px solid #cfdae1;color:#102b42}.mega-bar{max-width:1600px;margin:auto;padding:18px 5vw;display:flex;align-items:center;gap:30px;min-height:80px}.mega-brand{margin-right:auto;flex-shrink:0}.mega-brand img{width:172px;height:auto}.mega-quick{font-size:13px;font-weight:800;text-decoration:underline;text-underline-offset:5px}.mega-disclosure summary{list-style:none;display:flex;align-items:center;gap:9px;cursor:pointer;background:#102b42;color:#fff;padding:13px 20px;font-size:14px;font-weight:700;min-height:44px}.mega-disclosure summary::-webkit-details-marker{display:none}.mega-icon{font-size:24px;line-height:1}.mega-disclosure[open] .mega-icon{transform:rotate(45deg)}#mega-panel{position:absolute;top:100%;left:0;right:0;max-height:calc(100dvh - 90px);overflow-y:auto;overscroll-behavior:contain;background:#f8f7f1;box-shadow:0 25px 35px #071e342b;border-top:3px solid #ffa847;padding:35px 5vw 20px;display:grid;grid-template-columns:1fr 3fr;gap:35px}.mega-disclosure:not([open]) #mega-panel{display:none}.mega-intro{padding:20px;background:#102b42;color:#fff;align-self:start}.mega-intro>p{font-size:10px;letter-spacing:.12em;color:#ffc078}.mega-intro>strong{display:block;font-size:32px;line-height:1.1;margin:24px 0}.mega-intro>span{font-size:13px;line-height:1.8;color:#dce6ed}.mega-groups{display:grid;grid-template-columns:repeat(3,1fr);gap:25px}.mega-groups h2{font-size:12px;text-transform:uppercase;letter-spacing:.07em;color:#486173;margin:0 0 14px;padding-bottom:14px;border-bottom:1px solid #b6c6cf}.mega-groups ul{list-style:none;margin:0;padding:0}.mega-groups a{display:block;padding:12px 10px;margin:0 -10px}.mega-groups a:hover,.mega-groups a[aria-current=page]{background:#e5edf0}.mega-groups strong{display:flex;justify-content:space-between;gap:10px;font-size:15px;line-height:1.45}.mega-groups a>span{display:block;font-size:12px;line-height:1.7;color:#465e70;margin-top:5px}.mega-bottom{grid-column:1/-1;border-top:1px solid #b6c6cf;padding-top:20px;display:flex;flex-wrap:wrap;gap:15px 30px;font-size:12px}.mega-header a:focus-visible,.mega-header summary:focus-visible{outline:3px solid #b35b00;outline-offset:3px}.mega-header a:hover{text-decoration:underline;text-underline-offset:4px}@media(max-width:1000px){#mega-panel{grid-template-columns:1fr;gap:20px}.mega-intro{display:none}}@media(max-width:650px){.mega-bar{padding:14px 5vw;gap:12px;min-height:72px}.mega-brand img{width:148px}.mega-quick,.mega-desktop-word{display:none}.mega-disclosure summary{padding:10px 13px;font-size:13px}#mega-panel{padding:22px 6vw;max-height:calc(100dvh - 72px)}.mega-groups{grid-template-columns:1fr;gap:24px}.mega-groups h2{margin-bottom:6px}.mega-groups a{padding:12px 10px}.mega-groups a>span{font-size:13px}.mega-bottom{gap:20px}.mega-groups strong{font-size:17px}}@media(prefers-reduced-motion:reduce){.mega-icon{transition:none}}
</style>

---
import '../styles/global.css';
import Daylight from '../components/Daylight.astro';
import {
  ArrowRight,
  ArrowUpRight,
  BatteryCharging,
  Building2,
  ChevronDown,
  FileText,
  HousePlug,
  Menu,
  PackageCheck,
  PanelsTopLeft,
  PlugZap,
  Ruler,
  ShieldCheck,
  X,
  Zap,
} from '@lucide/astro';

const services = [
  {
    number: '01',
    title: 'Solar for homes',
    href: '/home-solar/',
    copy: 'System size starts with your electricity bill and usable roof area. We then account for daytime loads, shading and the equipment already on site.',
    bestFor: 'Houses and townhouses',
    icon: HousePlug,
  },
  {
    number: '02',
    title: 'Commercial solar',
    href: '/commercial-solar/',
    copy: 'For businesses, operating hours matter as much as roof space. We plan around when the property uses power and what the connection can support.',
    bestFor: 'Shops, offices and operating sites',
    icon: Building2,
  },
  {
    number: '03',
    title: 'Hybrid and battery systems',
    href: '/hybrid-solar/',
    copy: 'If backup is part of the brief, we identify the circuits that matter and size storage around the job it needs to do.',
    bestFor: 'Selected backup loads and stored solar',
    icon: BatteryCharging,
  },
];

const equipment = [
  {
    number: '01',
    title: 'Monocrystalline solar panels',
    range: 'Current 630 W option',
    copy: 'Panel count and layout follow the usable roof area, shade conditions, electrical design and expected daytime use.',
    icon: PanelsTopLeft,
  },
  {
    number: '02',
    title: 'Off-grid inverters',
    range: '4 kW to 12 kW families',
    copy: 'Options are available for properties that need independent power architecture, generator integration or limited grid access.',
    icon: PlugZap,
  },
  {
    number: '03',
    title: 'Hybrid inverters',
    range: 'Residential to commercial',
    copy: 'Selected systems can combine solar, grid, battery and agreed backup circuits. Net-metering readiness depends on the exact design and utility approval.',
    icon: Zap,
  },
  {
    number: '04',
    title: 'LiFePO4 battery storage',
    range: '5.12 kWh to 25 kWh listed options',
    copy: 'Indoor and outdoor battery families are available. Capacity is matched to essential loads, expected duration and reserve settings.',
    icon: BatteryCharging,
  },
];

const checks = [
  ['Recent electricity bill', 'Monthly cost is useful, but the pattern of use matters too.', FileText],
  ['Roof and shade', 'Usable area, orientation, roof condition and access affect the layout.', Ruler],
  ['Electrical setup', 'The existing supply, switchboard and connection need to suit the proposed system.', Zap],
  ['Connection route', 'We explain the net-metering or non-export route where relevant. Approval sits with the distribution utility.', ShieldCheck],
];

const projectPhotos = [
  {
    src: '/rooftop-solar-array.webp',
    alt: 'Solar panel array mounted on a white metal roof beneath a clear sky',
    title: 'Rooftop solar array',
    detail: 'Rooftop installation',
    featured: true,
  },
  {
    src: '/installed-felicity-solar-system.webp',
    alt: 'Wall-mounted Felicity Solar inverter, battery cabinet and electrical protection equipment',
    title: 'Hybrid inverter and battery system',
    detail: 'Installed indoor equipment',
  },
  {
    src: '/equipment-delivery.webp',
    alt: 'Packaged Felicity Solar inverter and lithium battery equipment outside a property',
    title: 'Equipment arrival',
    detail: 'Inverter and battery delivery',
  },
  {
    src: '/battery-units.webp',
    alt: 'Two crated lithium iron phosphate battery units inside a commercial space',
    title: 'LiFePO4 battery units',
    detail: 'Protected transport packaging',
  },
  {
    src: '/solar-equipment-transport.webp',
    alt: 'Packaged Felicity Solar inverter and lithium iron phosphate battery inside a vehicle',
    title: 'Equipment in transit',
    detail: 'Project logistics',
  },
];

const process = [
  ['Bill and goal review', 'Send a recent electricity bill and tell us whether the priority is daytime savings, backup, off-grid supply or future expansion.'],
  ['Qualified site survey', 'The appointed implementation team checks the roof, shade, access, electrical setup and project constraints.'],
  ['Written system proposal', 'You receive the proposed equipment, system scope, responsibility split and model-specific warranty information.'],
  ['Installation and handover', 'The appointed implementation partner completes approved technical work, testing, warranty registration and handover.'],
];

const faqs = [
  ['What size solar system do I need in the Philippines?', 'There is no useful standard answer. The right size depends on daytime electricity use, available roof area, shading, connection limits and whether storage is part of the plan.'],
  ['What Felicity Solar equipment can be considered?', 'Current options include off-grid and hybrid inverter families plus indoor and outdoor LiFePO4 battery storage. Final equipment depends on stock, compatibility, site conditions and the technical design.'],
  ['Will solar panels work during cloudy or rainy weather?', 'Yes, but output falls when there is less sunlight. The design should use realistic conditions and annual production estimates, not a perfect-day figure.'],
  ['Can my property apply for net metering?', 'Eligible renewable energy systems can apply through their distribution utility. Requirements and approval depend on current rules, the local utility and the proposed system.'],
  ['Do I need a battery with my solar system?', 'Not necessarily. A grid-connected system can operate without one. A battery becomes relevant when you want stored solar, selected backup loads or a route to greater energy independence.'],
  ['Who handles installation and after-sales?', 'Bright Solar handles initial education, assessment intake and qualified project routing. The appointed implementation partner handles final engineering, installation, permits, warranty registration and after-sales for the agreed project.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Bright Solar helps Philippine homes and businesses assess solar, hybrid and battery systems, with clear equipment options and partner installation." />
    <meta name="theme-color" content="#0a2342" />
    <meta property="og:title" content="Solar Panel Installation Planning Manila | Bright Solar" />
    <meta property="og:description" content="Practical solar assessment, current equipment options and qualified installation support for Philippine homes and businesses." />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Solar Panel Installation Planning Manila | Bright Solar</title>
  </head>
  <body class="bg-stone text-ink antialiased">
    <header id="top" class="site-header">
      <div class="page-shell flex h-[76px] items-center justify-between">
        <a href="#top" class="brand" aria-label="Bright Solar home">
          <img class="brand-logo" src="/bright-solar-logo.svg" alt="Bright Solar" width="1050" height="235" />
        </a>

        <nav class="hidden items-center gap-8 text-sm font-semibold lg:flex" aria-label="Primary navigation">
          <a class="nav-link" href="#systems">Systems</a>
          <a class="nav-link" href="#equipment">Equipment</a>
          <a class="nav-link" href="#projects">Projects</a>
          <a class="nav-link" href="#process">Process</a>
          <a class="nav-link" href="#faq">FAQs</a>
        </nav>

        <a href="#enquiry" class="button button-dark hidden lg:inline-flex">Prepare an assessment <ArrowUpRight size={17} /></a>
        <button id="menu-open" class="menu-button lg:hidden" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-menu"><Menu size={23} /></button>
      </div>
    </header>

    <div id="mobile-menu" class="fixed inset-0 z-50 hidden bg-ink text-white" role="dialog" aria-modal="true" aria-label="Mobile navigation">
      <div class="flex h-[76px] items-center justify-between border-b border-white/15 px-5">
        <a href="#top" class="brand"><img class="brand-logo brand-logo-reversed" src="/bright-solar-logo-reversed.svg" alt="Bright Solar" width="1050" height="235" /></a>
        <button id="menu-close" class="menu-button border-white/25" aria-label="Close navigation"><X size={23} /></button>
      </div>
      <nav class="flex flex-col px-5 pt-8 text-2xl font-bold">
        <a class="mobile-link" href="#systems">Systems</a>
        <a class="mobile-link" href="#equipment">Equipment</a>
        <a class="mobile-link" href="#projects">Projects</a>
        <a class="mobile-link" href="#process">Process</a>
        <a class="mobile-link" href="#faq">FAQs</a>
        <a class="button button-solar mt-8 w-fit" href="#enquiry">Prepare an assessment <ArrowRight size={17} /></a>
      </nav>
    </div>

    <main>
      <Daylight />

      <section id="systems" class="section bg-white">
        <div class="page-shell">
          <div class="section-intro">
            <div>
              <p class="eyebrow">What we assess</p>
              <h2>Start with the job the system needs to do.</h2>
            </div>
            <p>A package price is not a design. We look at the property and electricity use before deciding how much solar, what inverter and whether storage is worth including.</p>
          </div>

          <div class="mt-16 grid border-l border-t border-line lg:grid-cols-3">
            {services.map((service) => {
              const Icon = service.icon;
              return (
                <article class="service-card">
                  <div class="flex items-start justify-between">
                    <span class="service-number">{service.number}</span>
                    <Icon size={25} stroke-width={1.8} />
                  </div>
                  <h3>{service.title}</h3>
                  <p>{service.copy}</p>
                  <div class="service-fit"><span>Best for</span>{service.bestFor}</div>
                  <a href={service.href} aria-label={`Explore ${service.title}`}>Explore this system <ArrowRight size={16} /></a>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <section id="equipment" class="section equipment-section">
        <div class="page-shell">
          <div class="section-intro">
            <div>
              <p class="eyebrow">Current Felicity Solar options</p>
              <h2>Panels, inverters and batteries chosen as one system.</h2>
            </div>
            <p>Compare solar panels, off-grid and hybrid inverters, and LiFePO4 storage. Exact model availability, compatibility and warranty terms are confirmed in the written proposal.</p>
          </div>

          <div class="equipment-grid mt-16">
            {equipment.map((item) => {
              const Icon = item.icon;
              return (
                <article class="equipment-card">
                  <div class="equipment-card-head">
                    <span>{item.number}</span>
                    <Icon size={24} stroke-width={1.8} />
                  </div>
                  <p class="equipment-range">{item.range}</p>
                  <h3>{item.title}</h3>
                  <p>{item.copy}</p>
                </article>
              );
            })}
          </div>

          <div class="equipment-note">
            <PackageCheck size={25} stroke-width={1.8} />
            <div>
              <h3>Know the exact scope before committing.</h3>
              <p>Final proposals record the equipment models, installation scope, responsibility split, current manufacturer warranty route and after-sales owner. Features such as app monitoring, generator integration, backup-load separation and net-metering readiness depend on the selected system.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="assessment" class="section bg-deep text-white">
        <div class="page-shell grid gap-16 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
          <div>
            <p class="eyebrow eyebrow-light">Before we quote</p>
            <h2 class="max-w-lg">What needs to be checked first.</h2>
            <p class="mt-7 max-w-md text-base leading-8 text-white/72">These checks stop the design from becoming a list of equipment with no connection to the property.</p>
          </div>
          <div class="border-t border-white/20">
            {checks.map(([title, copy, icon]) => {
              const Icon = icon;
              return (
                <article class="assessment-row">
                  <Icon size={21} stroke-width={1.8} />
                  <h3>{title}</h3>
                  <p>{copy}</p>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <section id="projects" class="section project-section bg-white">
        <div class="page-shell">
          <div class="section-intro">
            <div>
              <p class="eyebrow">A closer look</p>
              <h2>From the rooftop to the battery.</h2>
            </div>
            <p>These supplied photographs show current rooftop solar, equipment deliveries, battery units and an installed inverter and storage configuration. Final systems vary by property and approved technical design.</p>
          </div>

          <div class="project-grid mt-16">
            {projectPhotos.map((photo) => (
              <figure class:list={['project-photo', photo.featured && 'project-photo-featured']}>
                <img src={photo.src} alt={photo.alt} loading={photo.featured ? 'eager' : 'lazy'} />
                <figcaption>
                  <strong>{photo.title}</strong>
                  <span>{photo.detail}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section id="process" class="section">
        <div class="page-shell">
          <div class="section-intro">
            <div>
              <p class="eyebrow">How the work moves</p>
              <h2>Clear responsibilities from enquiry to handover.</h2>
            </div>
            <p>Bright Solar handles initial education, assessment intake and qualified routing. The appointed implementation partner owns the final technical design, installation, permits, warranty registration and after-sales.</p>
          </div>

          <nav class="solar-resource-links" aria-label="Solar planning resources"><a href="/felicity-solar/">Felicity Solar range ↗</a><a href="/off-grid-solar/">Off-grid solar ↗</a><a href="/solar-panel-cost/">Compare solar costs ↗</a><a href="/net-metering/">Understand net metering ↗</a></nav>
          <ol class="process-list mt-16">
            {process.map(([title, copy], index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{title}</h3>
                <p>{copy}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="enquiry" class="section bg-white">
        <div class="page-shell"><p class="eyebrow">Start with your property</p><h2>Prepare your solar brief.</h2><p class="mt-7 max-w-2xl leading-8">Put your location, electricity use and priorities into a short downloadable brief. The tool works on your device and does not send an enquiry. Online enquiry delivery is not available yet.</p><a href="/assessment/" class="button button-solar mt-7">Build my brief <ArrowUpRight size={17}/></a></div>
      </section>

      <section id="faq" class="section">
        <div class="page-shell grid gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-24">
          <div>
            <p class="eyebrow">Solar systems Philippines FAQ</p>
            <h2>Common questions before choosing a solar system.</h2>
          </div>
          <div class="border-t border-line">
            {faqs.map(([question, answer]) => (
              <details class="faq-item group">
                <summary>
                  {question}
                  <span><ChevronDown size={17} /></span>
                </summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="page-shell">
        <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <a href="#top" class="brand"><img class="brand-logo brand-logo-reversed" src="/bright-solar-logo-reversed.svg" alt="Bright Solar" width="1050" height="235" /></a>
            <p>Solar assessment and product matching for Philippine homes and businesses, with technical delivery through appointed implementation partners.</p>
          </div>
          <nav aria-label="Footer navigation">
            <a href="#systems">Systems</a>
            <a href="#equipment">Equipment</a>
            <a href="#projects">Projects</a>
            <a href="#process">Process</a>
            <a href="/assessment/">Assessment brief</a>
            <a href="/privacy/">Privacy</a>
          </nav>
        </div>
        <div class="footer-bottom"><span>© {new Date().getFullYear()} Bright Solar.</span><span>Equipment, availability and installation scope are confirmed per project.</span></div>
      </div>
    </footer>

    <style>.solar-resource-links{display:flex;flex-wrap:wrap;gap:25px;padding:35px 0 0;font-weight:700}.solar-resource-links a{text-decoration:underline;text-underline-offset:5px}</style>
    <script>
      const openButton = document.querySelector('#menu-open');
      const closeButton = document.querySelector('#menu-close');
      const menu = document.querySelector('#mobile-menu');
      const mobileLinks = document.querySelectorAll('.mobile-link, #mobile-menu a[href="#enquiry"]');

      const openMenu = () => {
        menu?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        openButton?.setAttribute('aria-expanded', 'true');
      };
      const closeMenu = () => {
        menu?.classList.add('hidden');
        document.body.style.overflow = '';
        openButton?.setAttribute('aria-expanded', 'false');
      };

      openButton?.addEventListener('click', openMenu);
      closeButton?.addEventListener('click', closeMenu);
      mobileLinks.forEach((link) => link.addEventListener('click', closeMenu));

    </script>
  </body>
</html>

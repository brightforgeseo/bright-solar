---
import SiteLayout from '../layouts/SiteLayout.astro';
import DecisionTool from '../components/DecisionTool.astro';
import {solarPages} from '../data/solar-pages';
export function getStaticPaths(){return solarPages.map(page=>({params:{slug:page.slug},props:{page}}));}
const {page}=Astro.props;
---
<SiteLayout title={page.title} description={page.description}>
 <section class="route-hero"><div class="route-hero-copy"><a class="breadcrumb" href="/">Bright Solar /</a><p class="route-kicker">{page.eyebrow}</p><h1>{page.heading}<br/><span>{page.accent}</span></h1><p class="route-intro">{page.intro}</p><a class="solar-link-button" href="#checklist">Start with your property ↓</a></div><figure><img src={page.image} alt={page.imageAlt} width="896" height="1195" fetchpriority="high"/><figcaption>Bright Solar · Felicity Solar equipment options</figcaption></figure></section>
 <section class="route-answer"><h2>{page.question}</h2><p>{page.answer}</p></section>
 <section class="route-points" aria-label="Key decisions">{page.points.map((point,index)=><article><span class="route-number">0{index+1}</span><h2>{point.title}</h2><p>{point.body}</p></article>)}</section>
 <div class="route-content"><aside><p class="route-kicker">IN THIS ASSESSMENT</p><nav aria-label="On this page">{page.sections.map((section,index)=><a href={`#decision-${index}`}>{section.title}</a>)}<a href="#equipment-fit">Felicity Solar fit</a><a href="#checklist">Your preparation list</a></nav></aside><div>{page.sections.map((section,index)=><section id={`decision-${index}`} class="route-prose"><h2>{section.title}</h2>{section.paragraphs.map(paragraph=><p>{paragraph}</p>)}</section>)}</div></div>
 <section id="equipment-fit" class="product-fit"><img src="/installed-felicity-solar-system.webp" alt="Felicity Solar inverter and battery equipment installed together" loading="lazy" width="896" height="1195"/><div><p class="route-kicker">OUR PRODUCT RANGE</p><h2>Felicity Solar.<br/>Selected for the job.</h2><p>Our product range is Felicity Solar. We help match the panel, inverter and battery options to your property and priorities, rather than treating each component as a separate purchase.</p><p>The proposal needs to identify the exact models, their compatibility, installation scope and applicable warranty terms. A product family alone does not establish backup performance or utility approval.</p><a href="/felicity-solar/">Explore the equipment range ↗</a></div></section>
 <section id="checklist" class="preparation"><div><p class="route-kicker">BEFORE THE NEXT CONVERSATION</p><h2>Bring the details.<br/>Get a better brief.</h2><p>Use this list to prepare. These checks are a starting point, not technical approval.</p></div><div><DecisionTool slug={page.slug}/><ul>{page.checklist.map(item=><li>{item}</li>)}</ul><a href={`/assessment/?system=${page.slug}`} class="solar-link-button">Prepare my {page.label.toLowerCase()} brief ↗</a></div></section>
 {page.sources && <section class="route-sources"><h2>Check the official requirements</h2><p>Utility guidance checked 5 September 2026. Confirm current requirements directly before making an application.</p><ul>{page.sources.map(source=><li><a href={source.url}>{source.title} ↗</a></li>)}</ul></section>}
 <section class="related-routes"><p class="route-kicker">KEEP EXPLORING</p><nav aria-label="Related solar decisions">{page.related.map(slug=>{const related=solarPages.find(p=>p.slug===slug);return related&&<a href={`/${related.slug}/`}>{related.label}<span aria-hidden="true">↗</span></a>;})}</nav></section>
</SiteLayout>

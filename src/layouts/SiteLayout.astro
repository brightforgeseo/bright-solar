---
import '../styles/global.css';
import '../styles/solar-pages.css';
interface Props {title:string;description:string;}
const {title,description}=Astro.props;
const canonical=Astro.site ? new URL(Astro.url.pathname,Astro.site).href : undefined;
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/>
<meta name="theme-color" content="#102b42"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
{canonical && <><link rel="canonical" href={canonical}/><meta property="og:url" content={canonical}/></>}
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
</head><body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="route-header"><a href="/" aria-label="Bright Solar home"><img src="/bright-solar-logo.svg" width="172" height="39" alt="Bright Solar"/></a><nav aria-label="Main navigation"><a href="/#systems">Systems</a><a href="/solar-panel-cost/">Costs</a><a href="/net-metering/">Net metering</a><a class="route-header-action" href="/assessment/">Build your brief ↗</a></nav></header>
<main id="main"><slot/></main>
<footer class="route-footer"><div><img src="/bright-solar-logo-reversed.svg" width="172" height="39" alt="Bright Solar"/><p>Solar decisions start with the property.<br/>We help you ask the right questions.</p></div><nav aria-label="Solar systems"><a href="/home-solar/">Home solar</a><a href="/commercial-solar/">Commercial solar</a><a href="/hybrid-solar/">Hybrid solar & batteries</a><a href="/off-grid-solar/">Off-grid solar</a></nav><nav aria-label="Planning resources"><a href="/solar-panel-cost/">Solar costs</a><a href="/net-metering/">Net metering</a><a href="/assessment/">Prepare an assessment</a><a href="/privacy/">Privacy</a></nav><p class="footer-scope">We provide education, assessment intake and project qualification. Appointed implementation partners handle final engineering, installation, permits and agreed after-sales. Availability and scope are confirmed for each project.</p></footer>
</body></html>
